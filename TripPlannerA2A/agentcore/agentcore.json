{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "TripPlannerA2A",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "TripPlannerA2A"
  },
  "runtimes": [
    {
      "name": "FlightsAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "..\\app\\FlightsAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "envVars": [
        {
          "name": "TRAVEL_MCP_URL",
          "value": "https://mcp.kiwi.com"
        }
      ]
    },
    {
      "name": "WeatherMcpServer",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "..\\app\\WeatherMcpServer/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "MCP",
      "authorizerType": "AWS_IAM"
    },
    {
      "name": "WeatherAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "..\\app\\WeatherAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "additionalPolicies": [
        "../../TripPlannerA2A/agentcore/policies/weather-invoke-mcp-runtime.json"
      ]
      ,
      "envVars": [
        { "name": "WEATHER_MCP_RUNTIME_ARN", "value": "arn:aws:bedrock-agentcore:us-east-2:458934380591:runtime/TripPlannerA2A_WeatherMcpServer-7XJ7257LON" }
      ]
    },
    {
      "name": "OrchestratorAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "..\\app\\OrchestratorAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "DEFAULT_ACTOR_ID",
          "value": "mcp-memory-video-01"
        },
        {
          "name": "TRIPS_FUNCTION_ARN",
          "value": "arn:aws:lambda:us-east-2:458934380591:function:tripplanner-backend-TripsFunction-UQ1WQM8Y7BDP"
        },
        {
          "name": "ITINERARIES_FUNCTION_ARN",
          "value": "arn:aws:lambda:us-east-2:458934380591:function:tripplanner-backend-ItinerariesFunction-RUWw8aRgZeUy"
        },
        {
          "name": "RESERVATIONS_FUNCTION_ARN",
          "value": "arn:aws:lambda:us-east-2:458934380591:function:tripplanner-backend-ReservationsFunction-l1MpjOnVCyBx"
        },
        {
          "name": "PREFERENCES_FUNCTION_ARN",
          "value": "arn:aws:lambda:us-east-2:458934380591:function:tripplanner-backend-PreferencesFunction-0rqwJQvoBhO3"
        }
      ],
      "additionalPolicies": [
        "../../TripPlannerA2A/agentcore/policies/orchestrator-invoke-business-lambdas.json"
      ],
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-2.amazonaws.com/us-east-2_hVc7JUyoG/.well-known/openid-configuration",
          "allowedClients": [
            "27ri7q3j4etl4nm5ht6oki040r"
          ]
        }
      }
    }
  ],
  "memories": [
  {
    "name": "TripPlannerMemory",
    "eventExpiryDuration": 90,
    "strategies": [
      {
        "type": "USER_PREFERENCE",
        "name": "TravelerPreferences",
        "description": "Preferencias de viaje del usuario (horarios, aerolíneas, asientos).",
        "namespaceTemplates": [
          "/preferences/{actorId}/"
        ]
      },
      {
        "type": "SUMMARIZATION",
        "name": "SessionSummarizer",
        "description": "Resumen por sesión de planificación de viaje.",
        "namespaceTemplates": [
          "/summaries/{actorId}/{sessionId}/"
        ]
      },
      {
        "type": "SEMANTIC",
        "name": "TravelFacts",
        "description": "Hechos relevantes del viaje recuperables por significado.",
        "namespaceTemplates": [
          "/facts/{actorId}/"
        ]
      }
    ]
  }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}